# Copy to .env and fill in. run_almighty.sh loads .env at startup.

# Who answers. "claude" (the default) is Claude through the Claude Agent SDK on
# this Mac's Claude login — a Pro or Max plan, signed in once by running
# `claude` — with Groq as the fallback. "groq" is Groq only.
export LLM_PROVIDER=claude

# Groq: the fallback when Claude can't answer, and the only brain with
# LLM_PROVIDER=groq. Free key at https://console.groq.com → API Keys. With
# Claude you can leave it empty — she just has no fallback then.
export GROQ_API_KEY=""

# Your name — the persona and tool prompts address you by it. Quote it if it
# has a space. Leave it out and they just say "the user".
export OWNER_NAME="YourName"

# Optional: your town, with its state or country, e.g. "Austin, TX". A weather
# question that names no place then gets your town's forecast instead of
# "which city?" — naming any other city still gets that city's. Left empty,
# she asks where.
export HOME_LOCATION=""

# Troubleshooting only: 1 logs every utterance she captures while asleep and
# what Whisper heard, so you can see why a wake word didn't land. Leave it at 0
# day to day — it writes everything said near the mic into assistant.log.
export WAKE_DEBUG=0
